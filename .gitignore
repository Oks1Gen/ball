# Logs
*.log

# Keep current UI, ball and Ocean Depths sources; ignore other old asset copies.
/Assets/*
!/Assets/UI/
!/Assets/Balls/
!/Assets/OceanDepths/
!/Assets/Materials/
!/Assets/PetWorkshop/
!/Assets/Pets/
/Assets/Materials/*
!/Assets/Materials/HDStuds/
/Asets/

# Local upload lock; journals and dependency locks remain versioned.
/Assets/Balls/LowPolyV2/roblox/upload-journal.json.lock

# Wally vendor tree. Regenerated by `wally install` + tools/prepare-ui.mjs,
# never edited by hand and never versioned.
/RojoTest/Packages/

# Tool binaries. Versions are pinned in rokit.toml and installed by Rokit.
/RojoTest/tools/bin/

# Local snapshots and place-file checks
/RojoTest/backups/
*.rbxl
*.rbxlx
*.rbxlx.lock
*.rbxl.lock

# Blender auto-saves
*.blend1
*.blend2

# OS / editor
Thumbs.db
desktop.ini
.DS_Store
.vscode/
.idea/

# Temp
*.tmp
*.bak
.tools/
__pycache__/

# Leftovers of one-off checks at the root of the repository
/RCLONE_TEST*

/.mcp.json
